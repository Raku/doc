#!/usr/bin/env raku

=begin overview

Validate that all type docs have the same basic layout:

A title declaring the meta type.

An initial code block defining a class, role, etc.

A head1 called Methods

At least one head2 for each method

Under each head2 expect a method definition.

=end overview

use Test;

use RakuDoc::Test::Files;

my @files = RakuDoc::Test::Files.pods
    .grep(*.starts-with('doc/Type'))                     # every type document, except...
    .grep(* ne 'doc/Type/independent-routines.rakudoc'); # skip this one, it's a one off.

if @files {
    plan +@files;
} else {
    plan :skip-all<No rakudoc type files specified>
}

my @valid-metas = <class role enum package module Subset>;

for @files -> $file {
    subtest $file => {
        my @paras = $file.IO.slurp.AST.rakudoc[0].paragraphs; # top level elements in rakudoc

        my $para = @paras.shift;
        is $para.type, 'TITLE', 'first block is the title';
        ok $para.paragraphs.Str.starts-with(any(@valid-metas)), 'title starts with meta type';

        $para = @paras.shift;
        is $para.type, 'SUBTITLE', 'second block is the subtitle';

        my $found = False;
        while (!$found) {
            $para = @paras.shift;
            next if $para.Str.starts-with('X<');

            ok $para.Str.trim ~~ / ^ 'my '? @valid-metas/, 'declaration starts with meta type';
            $found = True;
        }

        my $test-message = 'Methods heading, level 1';
        $found = False;
        while (@paras && !$found) {
            $para = @paras.shift;
            next unless $para.?type.DEFINITE;
            next unless $para.type eq 'head' and $para.level == 1;
            next unless $para.paragraphs.Str eq "Methods\n\n";

            pass $test-message;
            $found = True;
        }
        unless $found {
            flunk $test-message;
        }

    }
}
